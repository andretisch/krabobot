# PyInstaller / local packaging artifacts (not committed)
build/
dist/
# Specs generated accidentally in the client root (canonical: packaging/*.spec)
/*.spec
# packaging/*.spec and packaging/README.md stay tracked — ignore backups/scratch only
packaging/*.bak*
packaging/*~
# Working config lives next to the app (copied from config.example.yaml)
/config.yaml
/config.yml
# Local / build-time model copies (portable bundles into build/*/models/)
/models/
# Meeting WAV / runtime recordings next to the app
/meetings/
